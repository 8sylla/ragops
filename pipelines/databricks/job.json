{
  "name": "ragops-fiches-pipeline",
  "description": "Bronze → silver (contrôles qualité) → gold (passages) sur le flux Service-Public.gouv.fr. Une exécution par jour, le flux étant mis à jour quotidiennement.",
  "git_source": {
    "git_url": "https://github.com/8sylla/ragops",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "schedule": {
    "quartz_cron_expression": "0 30 6 * * ?",
    "timezone_id": "Europe/Paris",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "parameters": [
    { "name": "catalog", "default": "workspace" },
    { "name": "schema", "default": "ragops" }
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": { "notebook_path": "pipelines/databricks/01_bronze", "source": "GIT" }
    },
    {
      "task_key": "silver",
      "depends_on": [{ "task_key": "bronze" }],
      "notebook_task": { "notebook_path": "pipelines/databricks/02_silver", "source": "GIT" }
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "silver" }],
      "notebook_task": { "notebook_path": "pipelines/databricks/03_gold", "source": "GIT" }
    }
  ]
}
